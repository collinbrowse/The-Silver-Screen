{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": ".cursor/hooks/run-unit-tests.sh",
        "timeout": 300,
        "failClosed": false,
        "loop_limit": 3
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-third-party-deps.sh",
        "failClosed": true
      }
    ]
  }
}
